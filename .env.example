# Supabase (Project Settings → API). Use the Sydney (ap-southeast-2) region.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of the app (used in invitation links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email (optional — without it, invite links are shown to the admin to copy)
RESEND_API_KEY=
EMAIL_FROM="Care Platform <no-reply@yourdomain.com.au>"

# Custom domains (Cloudflare for SaaS). Leave blank to hide the feature.
CLOUDFLARE_API_TOKEN=          # token with "SSL and Certificates: Edit" on the zone
CLOUDFLARE_ZONE_ID=            # zone of the platform domain
CUSTOM_DOMAIN_CNAME_TARGET=    # e.g. customers.careplatform.com.au
